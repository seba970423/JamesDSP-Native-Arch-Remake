new file mode 100644
index 0000000..3685490
--- /dev/null
+++ b/src/audio/pipewire/DevicePolicy.cpp
@@ -0,0 +1,77 @@
+#include "DevicePolicy.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QSaveFile>
+
+DevicePolicy::DevicePolicy(QString path) : path(std::move(path)) {
+    QFile file(this->path);
+    if (!file.exists()) return;
+    if (!file.open(QIODevice::ReadOnly)) { lastError = file.errorString(); return; }
+    QJsonParseError parse;
+    auto doc = QJsonDocument::fromJson(file.readAll(), &parse);
+    if (parse.error != QJsonParseError::NoError || !doc.isObject() ||
+        doc.object().value("version").toInt() != 1 || !doc.object().value("rules").isArray()) {
+        lastError = "Invalid device_rules.json; effects remain disabled until the file is repaired.";
+        return;
+    }
+    for (const auto& item : doc.object().value("rules").toArray()) {
+        auto rule = item.toObject();
+        if (!item.isObject() || !rule.value("device").isString() ||
+            rule.value("device").toString().isEmpty() || !rule.value("route").isString() ||
+            !rule.value("enabled").isBool()) {
+            entries = {}; lastError = "Invalid device rule; effects remain disabled."; return;
+        }
+        entries.append(rule);
+    }
+    processNewDevices = doc.object().value("defaultEnabled").toBool(false);
+}
+
+bool DevicePolicy::enabled(const QString& device, const QString& route) const {
+    if (!lastError.isEmpty()) return false;
+    for (const auto& item : entries) {
+        auto rule = item.toObject();
+        if (rule.value("device").toString() == device && rule.value("route").toString() == route)
+            return rule.value("enabled").toBool();
+    }
+    for (const auto& item : entries) {
+        auto rule = item.toObject();
+        if (rule.value("device").toString() == device && rule.value("route").toString() == "*")
+            return rule.value("enabled").toBool();
+    }
+    return processNewDevices;
+}
+
+bool DevicePolicy::save() {
+    if (!lastError.isEmpty()) return false; // Never silently replace a malformed file.
+    QDir().mkpath(QFileInfo(path).absolutePath());
+    QSaveFile file(path);
+    if (!file.open(QIODevice::WriteOnly)) return false;
+    auto data = QJsonDocument(QJsonObject{{"version", 1}, {"defaultEnabled", processNewDevices},
+                                        {"rules", entries}}).toJson();
+    if (file.write(data) != data.size()) { file.cancelWriting(); return false; }
+    return file.commit();
+}
+
+bool DevicePolicy::setEnabled(const QString& device, const QString& route, const QString& label, bool value) {
+    if (device.isEmpty() || route.isEmpty() || !lastError.isEmpty()) return false;
+    auto previous = entries;
+    for (qsizetype i = entries.size(); i > 0; --i) {
+        auto rule = entries.at(i - 1).toObject();
+        if (rule.value("device").toString() == device && rule.value("route").toString() == route)
+            entries.removeAt(i - 1);
+    }
+    entries.append(QJsonObject{{"device", device}, {"route", route}, {"label", label}, {"enabled", value}});
+    if (save()) return true;
+    entries = previous;
+    return false;
+}
+
+bool DevicePolicy::setDefaultEnabled(bool value) {
+    bool previous = processNewDevices;
+    processNewDevices = value;
+    if (save()) return true;
+    processNewDevices = previous;
+    return false;
+}
