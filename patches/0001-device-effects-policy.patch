diff --git a/src/interface/fragment/NativeDeviceWidget.cpp b/src/interface/fragment/NativeDeviceWidget.cpp
new file mode 100644
index 0000000..ec06dba
--- /dev/null
+++ b/src/interface/fragment/NativeDeviceWidget.cpp
@@ -0,0 +1,123 @@
+#include "NativeDeviceWidget.h"
+#include <algorithm>
+#include <QHeaderView>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QMessageBox>
+#include <QProcess>
+#include <QPushButton>
+#include <QSet>
+#include <QSignalBlocker>
+#include <QVBoxLayout>
+
+NativeDeviceWidget::NativeDeviceWidget(DevicePolicy* devicePolicy, DeviceProvider outputs, DeviceProvider sinks,
+    std::function<void()> refreshPolicy, QWidget* parent)
+    : QWidget(parent), policy(devicePolicy), outputDevices(std::move(outputs)), sinkDevices(std::move(sinks)),
+      notify(std::move(refreshPolicy)) {
+    auto* layout = new QVBoxLayout(this);
+    explanation = new QLabel(tr("Choose which outputs get effects. Audio follows your desktop's default output. "
+        "Applications assigned to another output keep that destination."), this);
+    explanation->setWordWrap(true);
+    layout->addWidget(explanation);
+    devices = new QTableWidget(0, 3, this);
+    devices->setObjectName("nativeDeviceRules");
+    devices->setHorizontalHeaderLabels({tr("Device"), tr("Output / route"), tr("Effects")});
+    devices->horizontalHeader()->setSectionResizeMode(0, QHeaderView::Stretch);
+    devices->horizontalHeader()->setSectionResizeMode(1, QHeaderView::Stretch);
+    devices->horizontalHeader()->setSectionResizeMode(2, QHeaderView::ResizeToContents);
+    devices->verticalHeader()->hide();
+    devices->setMinimumHeight(150);
+    layout->addWidget(devices);
+    newDevices = new QCheckBox(tr("Enable effects for new devices automatically"), this);
+    layout->addWidget(newDevices);
+    kernelStatus = new QLabel(this);
+    kernelStatus->setWordWrap(true);
+    layout->addWidget(kernelStatus);
+    auto* refreshButton = new QPushButton(tr("Refresh devices and real-time status"), this);
+    layout->addWidget(refreshButton);
+    connect(refreshButton, &QPushButton::clicked, this, [this] { refresh(); refreshKernel(); });
+    connect(devices, &QTableWidget::itemChanged, this, [this](QTableWidgetItem* item) {
+        if (item->column() != 2) return;
+        bool ok = policy->setEnabled(item->data(Qt::UserRole).toString(),
+            item->data(Qt::UserRole + 1).toString(), item->data(Qt::UserRole + 2).toString(),
+            item->checkState() == Qt::Checked);
+        if (!ok) QMessageBox::warning(this, tr("Device rules"), tr("Could not save the device rule. Check the configuration file and its permissions."));
+        notify(); refresh();
+    });
+    connect(newDevices, &QCheckBox::toggled, this, [this](bool value) {
+        if (!policy->setDefaultEnabled(value))
+            QMessageBox::warning(this, tr("Device rules"), tr("Could not save the default device rule."));
+        notify(); refresh();
+    });
+    timer.setInterval(2500);
+    connect(&timer, &QTimer::timeout, this, [this] { if (isVisible()) refresh(); });
+    timer.start();
+    refresh(); refreshKernel();
+}
+
+void NativeDeviceWidget::refresh() {
+    QSignalBlocker tableBlock(devices), defaultBlock(newDevices);
+    newDevices->setChecked(policy->defaultEnabled());
+    devices->setRowCount(0);
+    QSet<QString> shown;
+    auto append = [&](const QString& id, const QString& name, const QString& route, const QString& routeLabel) {
+        const QString key = id + QChar(0x1f) + route;
+        if (shown.contains(key)) return;
+        shown.insert(key);
+        int row = devices->rowCount(); devices->insertRow(row);
+        auto* label = new QTableWidgetItem(name);
+        label->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable);
+        label->setToolTip(id);
+        devices->setItem(row, 0, label);
+        auto* output = new QTableWidgetItem(routeLabel);
+        output->setFlags(Qt::ItemIsEnabled | Qt::ItemIsSelectable);
+        devices->setItem(row, 1, output);
+        auto* check = new QTableWidgetItem;
+        check->setFlags(Qt::ItemIsEnabled | Qt::ItemIsUserCheckable);
+        check->setData(Qt::UserRole, id);
+        check->setData(Qt::UserRole + 1, route);
+        check->setData(Qt::UserRole + 2, name + " — " + routeLabel);
+        check->setCheckState(policy->enabled(id, route) ? Qt::Checked : Qt::Unchecked);
+        devices->setItem(row, 2, check);
+    };
+    QSet<uint32_t> cardIds;
+    const auto sinks = sinkDevices();
+    for (const auto& device : outputDevices()) {
+        const bool hasSink = std::any_of(sinks.begin(), sinks.end(), [&](const auto& sink) { return sink.device_id == device.id; });
+        if (!hasSink && device.output_routes.isEmpty() && device.output_route_name.empty()) continue;
+        cardIds.insert(device.id);
+        const QString id = QString::fromStdString(device.name), name = QString::fromStdString(device.description);
+        append(id, name, "*", tr("All other routes"));
+        for (const auto& route : device.output_routes)
+            append(id, name, QString::fromStdString(route.name), QString::fromStdString(route.description));
+        if (!device.output_route_name.empty())
+            append(id, name, QString::fromStdString(device.output_route_name), QString::fromStdString(device.output_route_description));
+    }
+    for (const auto& sink : sinks) {
+        if (!cardIds.contains(sink.device_id))
+            append("sink:" + QString::fromStdString(sink.name), QString::fromStdString(sink.description), "*", tr("Output"));
+    }
+    for (const auto& entry : policy->rules()) {
+        auto rule = entry.toObject();
+        append(rule.value("device").toString(), rule.value("label").toString() + tr(" (saved)"),
+               rule.value("route").toString(), rule.value("route").toString());
+    }
+    if (!policy->error().isEmpty()) explanation->setText(policy->error());
+}
+
+void NativeDeviceWidget::refreshKernel() {
+    QProcess helper;
+    helper.start("/usr/bin/jamesdsp-native-diagnostics", {"--json"});
+    if (!helper.waitForFinished(3000) || helper.exitCode() != 0) {
+        kernelStatus->setText(tr("Real-time status unavailable. Run jamesdsp-native-diagnostics for details."));
+        return;
+    }
+    const auto result = QJsonDocument::fromJson(helper.readAllStandardOutput()).object();
+    const auto kernel = result.value("kernel").toObject();
+    const auto threads = result.value("threads").toArray();
+    int rt = 0;
+    for (const auto& thread : threads) if (thread.toObject().value("realtime").toBool()) ++rt;
+    const auto scheduling = result.value("threads_available").toBool() ? QString::number(rt) : tr("unavailable");
+    kernelStatus->setText(tr("Kernel: %1. Optional RT patch build: %2. Real-time threads in JamesDSP: %3.")
+        .arg(kernel.value("model").toString(), result.value("build_profile").toString(), scheduling));
+}
