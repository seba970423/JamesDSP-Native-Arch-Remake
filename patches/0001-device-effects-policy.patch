+++ b/src/audio/pipewire/DevicePolicy.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QString>
+
+// Stable device names and route names, never transient PipeWire numeric IDs.
+class DevicePolicy {
+public:
+    explicit DevicePolicy(QString path);
+    bool enabled(const QString& device, const QString& route) const;
+    bool setEnabled(const QString& device, const QString& route, const QString& label, bool enabled);
+    QJsonArray rules() const { return entries; }
+    QString error() const { return lastError; }
+    bool defaultEnabled() const { return processNewDevices; }
+    bool setDefaultEnabled(bool enabled);
+private:
+    bool save();
+    QString path;
+    QString lastError;
+    QJsonArray entries;
+    bool processNewDevices = false;
+};
