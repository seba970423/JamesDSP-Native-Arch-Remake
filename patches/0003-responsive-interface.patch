+void NativeDeviceWidget::installOnPage(QWidget* page, NativeDeviceWidget* controls) {
+    auto* pageLayout = qobject_cast<QVBoxLayout*>(page->layout());
+    auto* content = new QWidget;
+    content->setObjectName("nativeDevicesContent");
+    auto* contentLayout = new QVBoxLayout(content);
+    contentLayout->setContentsMargins(0, 0, 0, 0);
+    contentLayout->setSizeConstraint(QLayout::SetDefaultConstraint);
+    contentLayout->addWidget(controls);
+    while (auto* item = pageLayout->takeAt(0)) {
+        if (auto* widget = item->widget()) {
+            contentLayout->addWidget(widget);
+            delete item;
+        }
+        else if (item->spacerItem()) delete item;
+        else contentLayout->addItem(item);
+    }
+    contentLayout->addStretch();
+    if (auto* allowlist = content->findChild<QCheckBox*>("blocklistInvert")) {
+        allowlist->setToolTip(allowlist->text());
+        allowlist->setText(tr("Process only\nallowlisted apps"));
+    }
+    auto* scroll = new QScrollArea(page);
+    scroll->setObjectName("nativeDevicesScroll");
+    scroll->setFrameShape(QFrame::NoFrame);
+    scroll->setWidgetResizable(true);
+    scroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    scroll->setWidget(content);
+    pageLayout->addWidget(scroll);
+}
